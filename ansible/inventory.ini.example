[masters]
master-1 ansible_host=192.168.1.10
master-2 ansible_host=192.168.1.11
master-3 ansible_host=192.168.1.12

[workers]
worker-1 ansible_host=192.168.1.20
worker-2 ansible_host=192.168.1.21
worker-3 ansible_host=192.168.1.22

[kubernetes:children]
masters
workers

[kubernetes:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/task-manager
ansible_python_interpreter=/usr/bin/python3
