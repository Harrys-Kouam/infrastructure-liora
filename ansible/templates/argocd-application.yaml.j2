apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: task-manager-api
  namespace: argocd
spec:
  project: default
  source:
    repoURL: {{ manifests_repo_url | quote }}
    targetRevision: {{ manifests_repo_revision | quote }}
    path: {{ manifests_chart_path | quote }}
    helm:
      releaseName: task-manager-api
  destination:
    server: https://kubernetes.default.svc
    namespace: task-manager
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
