global_defs {
    router_id TASK_MANAGER_K8S
}

vrrp_script chk_haproxy {
    script "/usr/bin/pgrep -x haproxy"
    interval 2
    fall 2
    rise 1
}

vrrp_instance VI_KUBERNETES_API {
    state BACKUP
    interface {{ ansible_default_ipv4.interface }}
    virtual_router_id {{ keepalived_router_id }}
    priority {{ 150 - groups['masters'].index(inventory_hostname) * 10 }}
    advert_int 1
    unicast_src_ip {{ ansible_host }}
    unicast_peer {
{% for host in groups['masters'] if host != inventory_hostname %}
        {{ hostvars[host].ansible_host }}
{% endfor %}
    }
    virtual_ipaddress {
        {{ control_plane_vip }}/{{ control_plane_vip_prefix }} dev {{ ansible_default_ipv4.interface }}
    }
    track_script {
        chk_haproxy
    }
}
